# Copy to `.env` (gitignored) and fill in. Loaded by `npm run server` / `npm run dev`.

# AI provider for the per-page chat: "gemini" (default) or "claude".
AI_PROVIDER=gemini

# Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-2.5-flash).
# Examples: gemini-2.5-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash
