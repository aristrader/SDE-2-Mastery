# Copy to `.env` (gitignored) and fill in. Loaded by `npm run server` / `npm run dev`.

# AI provider for the per-page chat:
#   agy    (default) — local `agy` agent CLI; agentic (can edit/run files), cheap. No key needed.
#   gemini           — Gemini API; conversational only. Needs GEMINI_API_KEY below.
#   claude           — Claude Code CLI agent; agentic.
AI_PROVIDER=agy

# Optional: override the agy model (default: agy's own default).
# Examples (from `agy models`): "Gemini 3.5 Flash (Medium)", "Gemini 3.1 Pro (Low)"
# AGY_MODEL=Gemini 3.5 Flash (Medium)

# Optional: absolute path to the agy binary if it is not on PATH.
# AGY_BIN=/Users/you/.local/bin/agy

# Only needed if AI_PROVIDER=gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
